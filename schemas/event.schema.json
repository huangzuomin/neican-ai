{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neican.ai/schemas/event.schema.json",
  "title": "Event",
  "type": "object",
  "required": ["event_title", "event_type", "confidence"],
  "properties": {
    "event_title": { "type": "string" },
    "event_summary": { "type": "string" },
    "event_type": { "type": "string" },
    "event_date": { "type": "string" },
    "entities": { "type": "array", "items": { "type": "object" } },
    "topics": { "type": "array", "items": { "type": "string" } },
    "claims": { "type": "array", "items": { "$ref": "claim.schema.json" } },
    "importance_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "seo_value_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "knowledge_value_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "risk_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
